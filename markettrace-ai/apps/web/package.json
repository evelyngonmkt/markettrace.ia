{
  "name": "@markettrace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "pnpm --filter @markettrace/shared build && tsc -b --pretty false",
    "test": "pnpm --filter @markettrace/shared build && vitest run"
  },
  "dependencies": {
    "@markettrace/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
